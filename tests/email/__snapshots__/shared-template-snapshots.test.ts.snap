temFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;margin:14px 0 0;text-align:center;margin-top:14px;margin-right:0;margin-bottom:0;margin-left:0"><a href="https://infiniatransfers.com/privacy" style="color:#6b5530;text-decoration-line:none;text-decoration:underline" target="_blank">Privacy Policy</a>  ·  <a href="https://infiniatransfers.com/terms" style="color:#6b5530;text-decoration-line:none;text-decoration:underline" target="_blank">Terms of Service</a>  ·  <a href="https://infiniatransfers.com/contact" style="color:#6b5530;text-decoration-line:none;text-decoration:underline" target="_blank">Contact Support</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
