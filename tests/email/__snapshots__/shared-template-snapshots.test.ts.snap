radius:12px;padding:14px 20px;margin:20px 0"><tbody><tr><td><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Trip #</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0">TR-01</td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#ebe6df;border-top-width:1px;margin:14px 0"/><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Customer Name</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0">Sarah Khan</td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Customer Email</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0">sarah@example.com</td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Customer Phone</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0"></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#ebe6df;border-top-width:1px;margin:14px 0"/><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Vehicle Category</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0">Business</td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td class="em-label" valign="top" style="color:#77726b;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;padding:7px 16px 7px 0;width:38%">Vehicle Type</td><td class="em-value" valign="top" style="color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;padding:7px 0">Sedan</td></tr></tbody></table></td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" style="border-collapse:collapse"><tbody><tr><td style="border-top:1.5px solid #1a1917;color:#1a1917;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;font-weight:600;padding:14px 12px 2px 0">Total Amount</td><td align="right" style="border-top:1.5px solid #1a1917;color:#1a1917;font-family:&#x27;Playfair Display&#x27;, Georgia, &#x27;Times New Roman&#x27;, serif;font-size:24px;line-height:30px;padding:12px 0 2px;white-space:nowrap">AED 450.00</td></tr></tbody></table><a href="https://infiniatransfers.com/admin/bookings/1" class="em-btn" style="line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;border-radius:8px;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-size:14px;font-weight:600;letter-spacing:0.03em;text-align:center;margin:16px 10px 16px 0;background-color:#1a1917;border:1px solid #1a1917;color:#f4ece0;padding:15px 26px;padding-top:15px;padding-right:26px;padding-bottom:15px;padding-left:26px" target="_blank"><span><!--[if mso]><i style="mso-font-width:433.3333333333333%;mso-text-raise:22.5" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:11.25px">View Booking Details</span><span><!--[if mso]><i style="mso-font-width:433.3333333333333%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a><p style="font-size:15px;line-height:25px;color:#5c5955;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">This is an automated notification. Please review and assign a vendor to this booking.</p><p style="font-size:15px;line-height:25px;color:#5