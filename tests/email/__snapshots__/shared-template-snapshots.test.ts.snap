air Display&#x27;, Georgia, &#x27;Times New Roman&#x27;, serif;letter-spacing:0.34em;margin:0;padding-left:0.34em;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">INFINIA</p><p style="font-size:9px;line-height:12px;color:#9d917f;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-weight:600;letter-spacing:0.52em;margin:7px 0 0;padding-left:0.52em;margin-top:7px;margin-right:0;margin-bottom:0;margin-left:0">TRANSFERS</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#c6aa88;font-size:0;height:2px;line-height:2px"><tbody><tr><td> </td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="em-px" style="padding:40px 44px 0"><tbody><tr><td><p style="font-size:11px;line-height:16px;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;font-weight:600;letter-spacing:0.18em;margin:0 0 12px;text-transform:uppercase;color:#065f46;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0">Application approved</p><h1 class="em-h1" style="color:#1a1917;font-family:&#x27;Playfair Display&#x27;, Georgia, &#x27;Times New Roman&#x27;, serif;font-size:30px;font-weight:500;letter-spacing:-0.005em;line-height:38px;margin:0">Welcome to Infinia Transfers!</h1></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="em-px" style="padding:24px 44px 40px"><tbody><tr><td><p style="font-size:15px;line-height:25px;color:#5c5955;font-family:Inter, -apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hi <!-- -->Dunes Fleet<!-- -->,</p><table align="center" width="100%" border="0" cellPadding="0" cellS