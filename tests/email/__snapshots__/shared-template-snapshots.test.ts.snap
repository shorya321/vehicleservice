exports[`shared email templates render identically under the platform brand wallet/transaction-completed: wallet/transaction-completed text 1`] = `
"INFINIA TRANSFERS


TRANSACTION COMPLETED

Hi Acme Hotel Group,

A transaction has been credited to your wallet.

Transaction Type: Credit

----------------------------------------

Amount: +AED 500.00

----------------------------------------

Description: Wallet top up

----------------------------------------

Previous Balance: AED 250.00

New Balance: AED 750.00

----------------------------------------

Transaction Date: 10 August 2026

Transaction ID: TXN-0001

View Transaction History → https://infiniatransfers.com/business/wallet

