# =============================================================================
# Supabase Configuration
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# Stripe Configuration
# =============================================================================
# Standard Stripe keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Optional: dedicated signing secret if the customer booking webhook
# (/api/payment/webhook) is registered as its own Stripe endpoint.
# Falls back to STRIPE_WEBHOOK_SECRET when unset.
STRIPE_BOOKING_WEBHOOK_SECRET=
# Signing secret for the business wallet destination (/api/business/wallet/webhook).
# Falls back to STRIPE_WEBHOOK_SECRET when unset. Set this when two destinations are
# registered, so neither one silently ends up verifying against the other's secret.
STRIPE_WALLET_WEBHOOK_SECRET=

# Stripe Connect (for B2B multi-tenant payments)
# Get from: https://dashboard.stripe.com/settings/applications
STRIPE_CONNECT_CLIENT_ID=your_stripe_connect_client_id

# =============================================================================
# Security & Encryption
# =============================================================================
# Encryption key for sensitive data (Stripe Connect tokens)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_encryption_key

# HMAC secret for booking price integrity verification
# Generate with: openssl rand -hex 32
BOOKING_HMAC_SECRET=your_booking_hmac_secret

# Shared secret for cron-only endpoints (e.g. refresh-rates, prune-email-logs,
# prune-notifications). Every caller must send `Authorization: Bearer $CRON_SECRET`;
# Vercel Cron attaches that header itself once this variable is set on the project.
# Set it on Vercel, where the cron jobs actually run. Leave it unset on Coolify: the
# routes ship there too, and unset means they fail closed with 401.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# =============================================================================
# Email Service (Resend)
# =============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_REPLY_TO_EMAIL=support@yourdomain.com

# --- Mail transport -----------------------------------------------------------
# Which transport PLATFORM email uses. 'resend' (default) keeps the original Resend
# API path. 'smtp' routes platform mail through nodemailer instead.
#
# This is the rollback switch for the SMTP migration: if SMTP misbehaves in production,
# setting this back to 'resend' restores the previous behaviour with no code change and
# no redeploy of application code.
#
# Business tenants with their own credentials always send over SMTP regardless, because
# there is no Resend equivalent for an arbitrary customer mail server.
MAIL_TRANSPORT=resend

# Platform SMTP endpoint, used when MAIL_TRANSPORT=smtp. The defaults point at Resend
# over SMTP, so no new infrastructure or credential is required.
PLATFORM_SMTP_HOST=smtp.resend.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=resend
# Falls back to RESEND_API_KEY when unset.
PLATFORM_SMTP_PASS=

# --- Per-business SMTP credentials --------------------------------------------
# AES-256-GCM key protecting each business's stored SMTP password.
# 32 random bytes, base64. Generate with: openssl rand -base64 32
#
# Falls back to ENCRYPTION_KEY above when unset, so the feature works on an existing
# deployment without provisioning a new secret first. Set this explicitly to keep mail
# credentials on their own key.
EMAIL_ENCRYPTION_KEY=
# Version stamped into newly written ciphertext. Bump when rotating.
EMAIL_ENCRYPTION_KEY_VERSION=1
# Decrypt-only keys kept during a rotation window: "1:<base64>,2:<base64>".
# Without the old key listed here, every business silently reverts to platform sending.
EMAIL_ENCRYPTION_KEYS_RETIRED=

# =============================================================================
# Application Configuration
# =============================================================================
# App URL (for payment redirects, OAuth callbacks, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Site URL (main platform domain for custom domain routing)
# Production: https://yourdomain.com
# Development: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# =============================================================================
# Vercel Configuration (for Custom Domain Automation)
# =============================================================================
# Required for automatic custom domain management
# Get VERCEL_TOKEN: https://vercel.com/account/tokens (Create Token)
# Get VERCEL_PROJECT_ID: Project Settings → General → Project ID
# Get VERCEL_TEAM_ID: Team Settings → General → Team ID (only for team projects)

VERCEL_TOKEN=your_vercel_api_token
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id_optional

# =============================================================================
# Google Maps API (Optional)
# =============================================================================
# Get from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key